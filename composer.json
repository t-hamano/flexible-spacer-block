{
	"name": "t-hamano/flexible-spacer-block",
	"description": "WordPress plugin to add white space between blocks and customize its height for each device.",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Aki Hamano"
		}
	],
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.2",
		"squizlabs/php_codesniffer": "*",
		"wp-coding-standards/wpcs": "^3.4",
		"phpcompatibility/phpcompatibility-wp": "^3.0@alpha",
		"phpcompatibility/php-compatibility": "^10.0@alpha",
		"phpcompatibility/phpcompatibility-paragonie": "^2.0@alpha"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
